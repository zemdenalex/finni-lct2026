# Образец. Реальный key.properties лежит рядом, перекрыт .gitignore
# и в репозиторий не попадает никогда.
#
# 🔴 Здесь не должно появиться ни одного настоящего значения. Файл
# коммитится, а значит всё, что в нём написано, становится публичным
# и остаётся в истории навсегда — вычистить пароль из истории git
# можно только переписав её целиком.
#
# Как получить свой файл:
#   1. сгенерировать keystore (команда — в docs/sborka-i-dostavka.md,
#      раздел «Ключ подписи»);
#   2. скопировать этот файл: cp key.properties.example key.properties
#   3. подставить свои значения.
#
# Если key.properties нет, сборка не падает: android/app/build.gradle.kts
# откатывается на debug-ключ. Это удобно для `flutter run --release`
# и категорически не годится для сборки, которую отдают жюри или грузят
# в RuStore — такой APK подписан ключом, который есть у каждого
# разработчика в мире.

# Абсолютный путь до keystore. Сам файл — ВНЕ репозитория.
# macOS/Linux: /Users/<имя>/keys/finlit-upload.p12
# Windows: прямые слэши, C:/keys/finlit-upload.p12
storeFile=

# Пароль хранилища.
storePassword=

# Алиас ключа внутри хранилища (мы используем upload).
keyAlias=

# Пароль ключа. Обычно совпадает со storePassword.
keyPassword=
