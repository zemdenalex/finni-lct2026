<?xml version="1.0" encoding="utf-8"?>
<!--
  Адаптивная иконка. Android рисует её по собственной маске — круг, squircle
  или что выберет производитель, — и берёт для этого два слоя.

  🔴 Без этого файла лаунчер вписывал единственный квадратный PNG в свою
  маску целиком, и на экране телефона получалась наклейка внутри белого
  кольца. На карточке магазина и в тестах иконка при этом выглядела
  правильно: дефект видно только на устройстве.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
